{
  "name": "ruxstar-backend-services",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsx scripts/openapi.ts",
    "create-admin": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@google-cloud/storage": "^8.4.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
