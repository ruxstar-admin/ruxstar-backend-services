MONGODB_URI=mongodb://connected-app-dev:c.gAzaJ8E.77LQ5@ac-9zydoxv-shard-00-00.w85fygl.mongodb.net:27017,ac-9zydoxv-shard-00-01.w85fygl.mongodb.net:27017,ac-9zydoxv-shard-00-02.w85fygl.mongodb.net:27017/?ssl=true&replicaSet=atlas-13hy6d-shard-0&authSource=admin&appName=ruxstar-dev
PORT=8080
# dev | staging | prod. Defaults to prod when NODE_ENV=production, otherwise dev.
RUXSTAR_ENV=dev
LOG_LEVEL=info

# The API only connects when both are set, so it never writes to a database by accident.
MONGODB_URI=
MONGODB_DB=ruxstar_dev

# At least 32 characters. Without it every signed-in route returns 401.
JWT_SECRET=

# Comma-separated website origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000
# Parent domain for auth cookies in staging and prod, for example .ruxstar.com
COOKIE_DOMAIN=

# Apps below these versions get 426 Upgrade Required.
MIN_APP_VERSION=
MIN_DELIVERY_APP_VERSION=

# log prints codes to this terminal (refused in prod). msg91 texts them.
OTP_PROVIDER=log
# MSG91 Flow API, same account and DLT template as v1. The template variable is OTP.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
