# Copy to .env for local runs. Never commit real values.
# `npm run dev` also loads .env.local after .env, so local overrides can live there.

PORT=8080
# dev | staging | prod. Defaults to prod when NODE_ENV=production, otherwise dev.
RUXSTAR_ENV=dev
LOG_LEVEL=info

# The API only connects when both are set, so it never writes to a database by accident.
MONGODB_URI=
MONGODB_DB=ruxstar_dev

# At least 32 characters. Without it every signed-in route returns 401.
JWT_SECRET=

# Comma-separated website origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000
# Parent domain for auth cookies in staging and prod, for example .ruxstar.com
COOKIE_DOMAIN=

# Apps below these versions get 426 Upgrade Required.
MIN_APP_VERSION=
MIN_DELIVERY_APP_VERSION=

# log prints codes to this terminal (refused in prod). msg91 texts them.
OTP_PROVIDER=log
# MSG91 Flow API, same account and DLT template as v1. The template variable is OTP.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
# Texts per India day before the log warns (at 80% and past it). Sending is never blocked.
SMS_DAILY_LIMIT=5000

# log prints email codes to this terminal (refused in prod). smtp sends them with nodemailer.
EMAIL_PROVIDER=log
# Any SMTP account, for example Gmail with an app password: smtp.gmail.com, port 465 or 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender address. Defaults to SMTP_USER.
EMAIL_FROM=

# Profile photos. Without a bucket, uploads answer 503 PHOTO_UNAVAILABLE.
# Objects go under profile-pictures/<RUXSTAR_ENV>/, so dev and prod can share a bucket.
# Credentials: the service account on Cloud Run; on a laptop, `gcloud auth application-default login`.
# A public bucket used only for profile pictures. KYC and business files stay in the private ruxstar-photos.
GCS_BUCKET=ruxstar-profile-pictures
# Where the saved photos are read from. Defaults to https://storage.googleapis.com/<GCS_BUCKET>.
GCS_PUBLIC_BASE_URL=

# Post photos, in their own public bucket under post-media/<RUXSTAR_ENV>/, and businesses' public
# photos under business-media/<RUXSTAR_ENV>/.
# Without it, text posts still work and photo uploads answer 503 PHOTO_UNAVAILABLE.
GCS_MEDIA_BUCKET=ruxstar-post-media
# Defaults to https://storage.googleapis.com/<GCS_MEDIA_BUCKET>.
GCS_MEDIA_PUBLIC_BASE_URL=

# Customers' print files: a private bucket only the API reads. Files are deleted 30 days after an order ends
# (a lifecycle rule on custom time). Without it, uploads answer 503 FILES_UNAVAILABLE.
GCS_PRINT_BUCKET=ruxstar-print-files

# Customer payments with Cashfree Payment Gateway (not the KYC keys above).
# fake marks orders paid from a test button on the checkout page (refused in prod). Defaults to cashfree when both keys are set.
PAYMENTS_PROVIDER=
CASHFREE_PG_CLIENT_ID=
CASHFREE_PG_SECRET=
# sandbox | production
CASHFREE_PG_ENV=sandbox
CASHFREE_PG_API_VERSION=2023-08-01
# This API's public https origin, for Cashfree's webhook and return links. Leave empty on a laptop.
API_URL=

# Seals vendors' bank account numbers: 32 random bytes, base64. Create one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes saved bank accounts unreadable. Without it vendors can still add a UPI ID.
PAYOUT_ENCRYPTION_KEY=
